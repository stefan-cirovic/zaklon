{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zaklon",
  "version": "0.1.0",
  "identifier": "com.zaklon.app",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Zaklon",
    "category": "Utility",
    "shortDescription": "Offline home base: knowledge, maps, supplies and a local AI assistant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "longDescription": "Zaklon keeps a household's knowledge library, maps, supplies and a local AI assistant working without internet. Free and open source (GPL-3.0-or-later).",
    "copyright": "Zaklon contributors, GPL-3.0-or-later",
    "homepage": "https://zaklon.com"
  }
}
